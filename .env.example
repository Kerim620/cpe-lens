# CPE Lens startup defaults. Copy to .env only if you need overrides.
# Settings saved from the app are stored in SQLite and override these values.
# Restart the backend after editing this file.
CPE_LENS_HOST=127.0.0.1
CPE_LENS_PORT=8765
CPE_LENS_DATA_DIR=data
CPE_LENS_LOG_LEVEL=INFO
CPE_LENS_DEVICE_TIMEOUT_SECONDS=8
CPE_LENS_CONNECT_TIMEOUT_SECONDS=25
CPE_LENS_PROBE_TIMEOUT_SECONDS=75
CPE_LENS_HEARTBEAT_TIMEOUT_SECONDS=15
CPE_LENS_MONITOR_INTERVAL_SECONDS=30
CPE_LENS_SAMPLE_INTERVAL_SECONDS=5
CPE_LENS_TELEMETRY_SECTION_TIMEOUT_SECONDS=20
CPE_LENS_HISTORY_RAW_DAYS=30
CPE_LENS_HISTORY_HOURLY_DAYS=365

# Never put device credentials in this file.
